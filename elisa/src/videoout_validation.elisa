include "safe_range.elisa"

const module VideoOut:
    OK: i64 = 0
    MAX_DISPLAY_BUFFERS: i64 = 16
    MAX_DISPLAY_BUFFER_GROUPS: i64 = 4
    MAX_REASONABLE_FLIP_RATE: i64 = 60
    PIXEL_A8R8G8B8_SRGB: u32 = 0x80000000
    PIXEL_A8B8G8R8_SRGB: u32 = 0x80002200
    PIXEL_A2R10G10B10: u32 = 0x88060000
    PIXEL_A2R10G10B10_SRGB: u32 = 0x88000000
    PIXEL_A2R10G10B10_BT2020_PQ: u32 = 0x88740000
    PIXEL_A16R16G16B16_FLOAT: u32 = 0xC1060000
    TILING_TILE: i64 = 0
    TILING_LINEAR: i64 = 1

const module VideoOutError:
    INVALID_VALUE: i64 = 0x80290001
    INVALID_ADDRESS: i64 = 0x80290002
    INVALID_PIXEL_FORMAT: i64 = 0x80290003
    INVALID_PITCH: i64 = 0x80290004
    INVALID_TILING_MODE: i64 = 0x80290007
    INVALID_ASPECT_RATIO: i64 = 0x80290008
    INVALID_INDEX: i64 = 0x8029000A
    INVALID_HANDLE: i64 = 0x8029000B

struct VideoOutAttributeFacts:
    pixel_format: u32
    tiling_mode: i64
    aspect_ratio: i64
    width: u64
    height: u64
    pitch_in_pixel: u64
    reserved0: u64
    reserved1: u64

def videoout_is_supported_pixel_format(pixel_format: u32) -> bool:
    if pixel_format == VideoOut::PIXEL_A8R8G8B8_SRGB:
        return true
    if pixel_format == VideoOut::PIXEL_A8B8G8R8_SRGB:
        return true
    if pixel_format == VideoOut::PIXEL_A2R10G10B10:
        return true
    if pixel_format == VideoOut::PIXEL_A2R10G10B10_SRGB:
        return true
    if pixel_format == VideoOut::PIXEL_A2R10G10B10_BT2020_PQ:
        return true
    return pixel_format == VideoOut::PIXEL_A16R16G16B16_FLOAT

def videoout_pixel_format_bpp(pixel_format: u32) -> u64:
    return 8 if pixel_format == VideoOut::PIXEL_A16R16G16B16_FLOAT else 4

def videoout_validate_flip_rate(rate: i64) -> i64:
    if rate < 0 or rate > VideoOut::MAX_REASONABLE_FLIP_RATE:
        return VideoOutError::INVALID_VALUE
    return VideoOut::OK

def videoout_validate_buffer_index(buf_id: i64, registered: bool) -> i64:
    if buf_id < 0 or buf_id >= VideoOut::MAX_DISPLAY_BUFFERS:
        return VideoOutError::INVALID_INDEX
    if not registered:
        return VideoOutError::INVALID_INDEX
    return VideoOut::OK

def videoout_validate_register_shape(start_index: i64, buffer_num: i64, has_attribute: bool, has_addresses: bool) -> i64:
    if not has_attribute or not has_addresses:
        return VideoOutError::INVALID_VALUE
    if start_index < 0 or buffer_num <= 0:
        return VideoOutError::INVALID_VALUE
    if start_index >= VideoOut::MAX_DISPLAY_BUFFERS or buffer_num > VideoOut::MAX_DISPLAY_BUFFERS:
        return VideoOutError::INVALID_VALUE
    if start_index > VideoOut::MAX_DISPLAY_BUFFERS - buffer_num:
        return VideoOutError::INVALID_VALUE
    return VideoOut::OK

def videoout_validate_attribute(attribute: VideoOutAttributeFacts) -> i64:
    if not videoout_is_supported_pixel_format(attribute.pixel_format):
        return VideoOutError::INVALID_PIXEL_FORMAT
    if attribute.reserved0 != 0 or attribute.reserved1 != 0:
        return VideoOutError::INVALID_VALUE
    if attribute.aspect_ratio != 0:
        return VideoOutError::INVALID_ASPECT_RATIO
    if attribute.width > attribute.pitch_in_pixel:
        return VideoOutError::INVALID_PITCH
    if attribute.tiling_mode < VideoOut::TILING_TILE or attribute.tiling_mode > VideoOut::TILING_LINEAR:
        return VideoOutError::INVALID_TILING_MODE
    return VideoOut::OK

def videoout_buffer_guest_size(attribute: VideoOutAttributeFacts) -> SafeRange:
    row_bytes: u64 = attribute.pitch_in_pixel * videoout_pixel_format_bpp(attribute.pixel_format)
    total_bytes: u64 = row_bytes * attribute.height
    if attribute.pitch_in_pixel != 0 and row_bytes / attribute.pitch_in_pixel != videoout_pixel_format_bpp(attribute.pixel_format):
        return safe_range_invalid(0)
    if attribute.height != 0 and total_bytes / attribute.height != row_bytes:
        return safe_range_invalid(0)
    return safe_range_make(0, total_bytes)

def shadps4_elisa_videoout_validate_register_shape_impl(start_index: i64, buffer_num: i64, has_attribute: int, has_addresses: int) -> i64:
    return videoout_validate_register_shape(start_index, buffer_num, has_attribute != 0, has_addresses != 0)

def shadps4_elisa_videoout_validate_attribute_impl(pixel_format: u32, tiling_mode: i64, aspect_ratio: i64, width: u64, height: u64, pitch_in_pixel: u64, reserved0: u64, reserved1: u64) -> i64:
    attribute: VideoOutAttributeFacts = VideoOutAttributeFacts(pixel_format, tiling_mode, aspect_ratio, width, height, pitch_in_pixel, reserved0, reserved1)
    return videoout_validate_attribute(attribute)

def shadps4_elisa_videoout_validate_flip_rate_impl(rate: i64) -> i64:
    return videoout_validate_flip_rate(rate)

def shadps4_elisa_videoout_validate_buffer_index_impl(buf_id: i64, registered: int) -> i64:
    return videoout_validate_buffer_index(buf_id, registered != 0)

def shadps4_elisa_videoout_buffer_guest_size_impl(pixel_format: u32, width: u64, height: u64, pitch_in_pixel: u64, out_size: mutable u64&) -> int:
    attribute: VideoOutAttributeFacts = VideoOutAttributeFacts(pixel_format, VideoOut::TILING_LINEAR, 0, width, height, pitch_in_pixel, 0, 0)
    size: SafeRange = videoout_buffer_guest_size(attribute)
    if not size.ok:
        out_size[0] <- 0
        return 0
    out_size[0] <- safe_range_size(size)
    return 1

export func shadps4_elisa_videoout_validate_register_shape(start_index: i64, buffer_num: i64, has_attribute: int, has_addresses: int) -> i64 = shadps4_elisa_videoout_validate_register_shape_impl
export func shadps4_elisa_videoout_validate_attribute(pixel_format: u32, tiling_mode: i64, aspect_ratio: i64, width: u64, height: u64, pitch_in_pixel: u64, reserved0: u64, reserved1: u64) -> i64 = shadps4_elisa_videoout_validate_attribute_impl
export func shadps4_elisa_videoout_validate_flip_rate(rate: i64) -> i64 = shadps4_elisa_videoout_validate_flip_rate_impl
export func shadps4_elisa_videoout_validate_buffer_index(buf_id: i64, registered: int) -> i64 = shadps4_elisa_videoout_validate_buffer_index_impl
export func shadps4_elisa_videoout_buffer_guest_size(pixel_format: u32, width: u64, height: u64, pitch_in_pixel: u64, out_size: mutable u64&) -> int = shadps4_elisa_videoout_buffer_guest_size_impl
